# 部署密钥。别提交、别粘到聊天里。
DEPLOYER_PK=0x你的部署私钥
BSC_RPC_URL=https://lb.drpc.live/bsc/AsVs23QoLEOwisC7Py3FTOo-9Orrf6UR8a6vijtBrJVX
BSCSCAN_API_KEY=用于 --verify 自动开源

# 金库初始收单价（wei）。0 = 金库只攒钱不收货，飞轮不转。
INIT_BID=200000000000000000
# 收单价上限（wei），默认 2 BNB
MAX_BID=2000000000000000000

# 不填则三个角色都用部署钱包
# DEV_WALLET=0x
# TEAM_WALLET=0x
# AIRDROP_WALLET=0x

# 第二步 Launch 用，从第一步的输出里抄
# NLSTR_ADDR=0x
# HOOK_ADDR=0x
# TREASURY_ADDR=0x
